        "text": "=email subject:{{ $json.subject }}\nemail body: {{ $json.text }}\ntimestamp:{{ $json.headers.date }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an assistant that classifies and extracts data from emails.\n\nThoroughly study the email subject and the body and then classify the email's intent into 4 categories:\n\n-New Application: Only when a new application is submitted. \n\n-General Question: When some question is asked about the application process or any other general question.\n\n-Status update- When the user asks about update of their application status.\n\n-Irrelevant-Any emails not fitting the above categories will come here.\n\n\nAlso Study the Email subject and Email body and extract the following information:\n\n- Organization name: The organization that the sender belongs to.\n\n- Contact person: The name of the sender.\n\n- Project title: The project they are applying the grant for.\n\nRules for data extraction\n- If contact person is not mentioned and the intent is New application , then contact person is 'sender'.\n- If Organization name and /or Project title is not mentioned , leave the fields empty.\n-Always fill the intent field\n\n\n\n"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        -1072,
        640
      ],
      "id": "757d4021-6f99-44ec-b159-4f8c4051e4fc",
      "name": "AI Agent",
      "retryOnFail": true,
      "alwaysOutputData": false,
      "notes": "Keep the fields empty if they are not found, except the intent field"
    },
