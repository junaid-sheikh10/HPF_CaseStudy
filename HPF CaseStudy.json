        "jsonSchemaExample": "{\n  \"intent\": \"New Application\",\n  \"organization_name\": \"Helping Hands Foundation\",\n  \"contact_person\": \"Jane Doe\",\n  \"project_title\": \"Community Health Outreach\",\n  \"timestamp\":\"2025-10-19 15:21 \"\n}\n"
